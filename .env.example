# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (MySQL 8.0 with connection pool sizing for high concurrency)
DATABASE_URL="mysql://reachinbox_user:reachinbox_password@localhost:3306/reachinbox?connection_limit=30&pool_timeout=20"

# Redis (BullMQ + Rate Limiter + Sessions)
REDIS_URL="redis://localhost:6379"

# Elasticsearch (Read Projection)
ELASTICSEARCH_URL="http://localhost:9200"

# Session Secret (Min 32 chars)
SESSION_SECRET="super-secret-session-key-must-be-at-least-32-chars-long"
SESSION_TTL_SECONDS=604800

# Symmetric Credential Encryption Key (AES-256-GCM 32-byte hex string)
# Example generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Slack OAuth 2.0 (Incoming Webhook)
SLACK_CLIENT_ID="your-slack-client-id"
SLACK_CLIENT_SECRET="your-slack-client-secret"
SLACK_CALLBACK_URL="http://localhost:4000/api/v1/integrations/slack/callback"

# Worker & Concurrency Configuration
EMAIL_WORKER_CONCURRENCY=20
DEFAULT_SENDER_HOURLY_LIMIT=100
DEFAULT_MINIMUM_DELAY_MS=2000

# Email Sending & Limits
MAX_EMAILS_PER_CAMPAIGN=5000
MAX_CSV_SIZE_BYTES=5242880
MAX_SUBJECT_LENGTH=255
MAX_BODY_LENGTH=100000

# Email Retries
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=5000
