# Multi-stage production build for ReachInbox Distributed Worker
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@12.5.1

COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY apps/worker/ ./apps/worker/
COPY prisma/ ./prisma/

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @reachinbox/shared-types build
RUN pnpm --filter @reachinbox/api prisma generate --schema=../../prisma/schema.prisma
RUN pnpm --filter @reachinbox/worker build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN npm install -g pnpm@12.5.1

COPY --from=builder /app/pnpm-workspace.yaml /app/package.json ./
COPY --from=builder /app/packages/shared-types/package.json ./packages/shared-types/
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/worker/package.json ./apps/worker/
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/api/dist/infrastructure/redis/rate-limiter.lua ./apps/api/dist/infrastructure/redis/rate-limiter.lua
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/worker/node_modules ./apps/worker/node_modules

CMD ["node", "apps/worker/dist/worker.js"]
