{
  "name": "@reachinbox/backend",
  "version": "1.0.0",
  "description": "ReachInbox Express API, BullMQ Workers, and Database Backend",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma db push --schema=prisma/schema.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^5.18.0",
    "@bull-board/express": "^5.18.0",
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "^5.22.0",
    "@slack/web-api": "^7.0.4",
    "bullmq": "^5.7.9",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pino": "^8.20.0",
    "pino-http": "^9.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.8",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
